<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Teams v2: team as container, groups carry the matching criteria and members.

        Created alongside the v1 rcm_team tables rather than replacing them, so both
        models run in parallel during migration.
    -->

    <changeSet author="optima" id="20260903-rcm-team-v2">
        <createTable tableName="rcm_team_v2">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_rcm_team_v2"/>
            </column>
            <column name="vendor_id" type="BIGINT"/>
            <column name="name" type="${varchar}(255)">
                <constraints nullable="false"/>
            </column>
            <column name="name_ar" type="${varchar}(255)"/>
            <column name="description" type="${cLongText}"/>
            <column name="is_active" type="BOOLEAN" defaultValue="true"/>
            <!-- Health licence, matching v1's branches.healthLicense === facilityId -->
            <column name="facility_id" type="${varchar}(120)"/>
            <column name="division" type="${varchar}(10)">
                <constraints nullable="false"/>
            </column>
            <column name="encounter_scope" type="${varchar}(10)" defaultValue="BOTH">
                <constraints nullable="false"/>
            </column>
            <column name="logic_axis" type="${varchar}(20)" defaultValue="DEPARTMENT">
                <constraints nullable="false"/>
            </column>
            <column name="high_cost_threshold" type="DOUBLE"/>
            <column name="rotation_enabled" type="BOOLEAN" defaultValue="false"/>
            <column name="rotation_frequency" type="${varchar}(20)"/>
            <column name="next_rotation_date" type="DATE"/>
            <column name="last_rotation_at" type="${datetimeType}"/>
            <column name="rotation_offset" type="INTEGER" defaultValueNumeric="0"/>
            <column name="created_by" type="${varchar}(50)"/>
            <column name="created_date" type="${datetimeType}"/>
            <column name="last_modified_by" type="${varchar}(50)"/>
            <column name="last_modified_date" type="${datetimeType}"/>
        </createTable>

        <createIndex tableName="rcm_team_v2" indexName="idx_rcm_team_v2_active">
            <column name="is_active"/>
        </createIndex>
        <createIndex tableName="rcm_team_v2" indexName="idx_rcm_team_v2_vendor">
            <column name="vendor_id"/>
        </createIndex>
        <createIndex tableName="rcm_team_v2" indexName="idx_rcm_team_v2_facility">
            <column name="facility_id"/>
        </createIndex>
        <createIndex tableName="rcm_team_v2" indexName="idx_rcm_team_v2_division">
            <column name="division"/>
        </createIndex>
    </changeSet>

    <changeSet author="optima" id="20260903-rcm-team-v2-branch">
        <createTable tableName="rcm_team_v2_branch">
            <column name="rcm_team_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="branch_id" type="BIGINT"/>
            <column name="sort_order" type="INTEGER"/>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="rcm_team_id"
                                 baseTableName="rcm_team_v2_branch"
                                 constraintName="fk_rcm_team_v2_branch_team"
                                 referencedColumnNames="id"
                                 referencedTableName="rcm_team_v2"
                                 onDelete="CASCADE"/>
        <createIndex tableName="rcm_team_v2_branch" indexName="idx_rcm_team_v2_branch_team">
            <column name="rcm_team_id"/>
        </createIndex>
    </changeSet>

    <changeSet author="optima" id="20260903-rcm-team-group">
        <createTable tableName="rcm_team_group">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_rcm_team_group"/>
            </column>
            <column name="rcm_team_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="${varchar}(255)">
                <constraints nullable="false"/>
            </column>
            <column name="name_ar" type="${varchar}(255)"/>
            <column name="description" type="${cLongText}"/>
            <column name="is_active" type="BOOLEAN" defaultValue="true"/>
            <column name="encounter_scope" type="${varchar}(10)" defaultValue="BOTH"/>
            <!-- Position in the team's rotation order; members shift n -> n+1 -->
            <column name="rotation_order" type="INTEGER"/>
            <column name="created_by" type="${varchar}(50)"/>
            <column name="created_date" type="${datetimeType}"/>
            <column name="last_modified_by" type="${varchar}(50)"/>
            <column name="last_modified_date" type="${datetimeType}"/>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="rcm_team_id"
                                 baseTableName="rcm_team_group"
                                 constraintName="fk_rcm_team_group_team"
                                 referencedColumnNames="id"
                                 referencedTableName="rcm_team_v2"
                                 onDelete="CASCADE"/>
        <createIndex tableName="rcm_team_group" indexName="idx_rcm_team_group_team">
            <column name="rcm_team_id"/>
        </createIndex>
        <createIndex tableName="rcm_team_group" indexName="idx_rcm_team_group_active">
            <column name="is_active"/>
        </createIndex>
    </changeSet>

    <changeSet author="optima" id="20260903-rcm-team-group-criteria">
        <!-- Typed criteria, one table per dimension. Replaces v1's comma-separated tag string. -->
        <createTable tableName="rcm_team_group_work_item_type">
            <column name="rcm_team_group_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="work_item_type" type="${varchar}(40)"/>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="rcm_team_group_id"
                                 baseTableName="rcm_team_group_work_item_type"
                                 constraintName="fk_rcm_group_wit_group"
                                 referencedColumnNames="id"
                                 referencedTableName="rcm_team_group"
                                 onDelete="CASCADE"/>
        <createIndex tableName="rcm_team_group_work_item_type" indexName="idx_rcm_group_wit_group">
            <column name="rcm_team_group_id"/>
        </createIndex>

        <createTable tableName="rcm_team_group_department">
            <column name="rcm_team_group_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <!-- RcmDepartment enum name, e.g. CARDIOLOGY -->
            <column name="department" type="${varchar}(60)"/>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="rcm_team_group_id"
                                 baseTableName="rcm_team_group_department"
                                 constraintName="fk_rcm_group_dept_group"
                                 referencedColumnNames="id"
                                 referencedTableName="rcm_team_group"
                                 onDelete="CASCADE"/>
        <createIndex tableName="rcm_team_group_department" indexName="idx_rcm_group_dept_group">
            <column name="rcm_team_group_id"/>
        </createIndex>

        <createTable tableName="rcm_team_group_payer">
            <column name="rcm_team_group_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="payer_id" type="BIGINT"/>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="rcm_team_group_id"
                                 baseTableName="rcm_team_group_payer"
                                 constraintName="fk_rcm_group_payer_group"
                                 referencedColumnNames="id"
                                 referencedTableName="rcm_team_group"
                                 onDelete="CASCADE"/>
        <createIndex tableName="rcm_team_group_payer" indexName="idx_rcm_group_payer_group">
            <column name="rcm_team_group_id"/>
        </createIndex>

        <createTable tableName="rcm_team_group_claim_status">
            <column name="rcm_team_group_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="claim_status" type="${varchar}(40)"/>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="rcm_team_group_id"
                                 baseTableName="rcm_team_group_claim_status"
                                 constraintName="fk_rcm_group_status_group"
                                 referencedColumnNames="id"
                                 referencedTableName="rcm_team_group"
                                 onDelete="CASCADE"/>
        <createIndex tableName="rcm_team_group_claim_status" indexName="idx_rcm_group_status_group">
            <column name="rcm_team_group_id"/>
        </createIndex>
    </changeSet>

    <changeSet author="optima" id="20260903-rcm-team-group-member">
        <!--
            Membership is its own table, not a collection on the group, because each
            row carries the immutable home_group_id that rotation is reckoned against.
        -->
        <createTable tableName="rcm_team_group_member">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_rcm_team_group_member"/>
            </column>
            <column name="rcm_team_group_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <!-- Denormalised for cheap team-level roster and capacity queries -->
            <column name="rcm_team_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <!-- Where the member started; never rewritten by rotation -->
            <column name="home_group_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="last_rotated_at" type="${datetimeType}"/>
            <column name="created_by" type="${varchar}(50)"/>
            <column name="created_date" type="${datetimeType}"/>
            <column name="last_modified_by" type="${varchar}(50)"/>
            <column name="last_modified_date" type="${datetimeType}"/>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="rcm_team_group_id"
                                 baseTableName="rcm_team_group_member"
                                 constraintName="fk_rcm_group_member_group"
                                 referencedColumnNames="id"
                                 referencedTableName="rcm_team_group"
                                 onDelete="CASCADE"/>
        <addUniqueConstraint tableName="rcm_team_group_member"
                             columnNames="rcm_team_group_id, user_id"
                             constraintName="uk_group_member"/>
        <createIndex tableName="rcm_team_group_member" indexName="idx_rcm_group_member_group">
            <column name="rcm_team_group_id"/>
        </createIndex>
        <createIndex tableName="rcm_team_group_member" indexName="idx_rcm_group_member_team">
            <column name="rcm_team_id"/>
        </createIndex>
        <createIndex tableName="rcm_team_group_member" indexName="idx_rcm_group_member_user">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
