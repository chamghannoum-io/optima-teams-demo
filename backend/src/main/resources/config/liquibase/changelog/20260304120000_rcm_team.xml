<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet author="codex" id="20260304-rcm-team">
        <createTable tableName="rcm_team">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_rcm_team"/>
            </column>
            <column name="name" type="${varchar}(255)">
                <constraints nullable="false"/>
            </column>
            <column name="name_ar" type="${varchar}(255)"/>
            <column name="description" type="${cLongText}"/>
            <column name="is_active" type="BOOLEAN" defaultValue="true"/>
            <column name="created_by" type="${varchar}(50)"/>
            <column name="created_date" type="${datetimeType}"/>
            <column name="last_modified_by" type="${varchar}(50)"/>
            <column name="last_modified_date" type="${datetimeType}"/>
        </createTable>

        <createIndex tableName="rcm_team" indexName="idx_rcm_team_active">
            <column name="is_active"/>
        </createIndex>
        <createIndex tableName="rcm_team" indexName="idx_rcm_team_name">
            <column name="name"/>
        </createIndex>
    </changeSet>

    <changeSet author="codex" id="20260304-rcm-team-user">
        <createTable tableName="rcm_team_user">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_rcm_team_user"/>
            </column>
            <column name="rcm_team_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT"/>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="rcm_team_id"
                                 baseTableName="rcm_team_user"
                                 constraintName="fk_rcm_team_user_team"
                                 referencedColumnNames="id"
                                 referencedTableName="rcm_team"
                                 onDelete="CASCADE"/>
        <createIndex tableName="rcm_team_user" indexName="idx_rcm_team_user_team">
            <column name="rcm_team_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
