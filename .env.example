# Copy to .env and fill in the real values. .env is gitignored — never commit it.
#
#   cp .env.example .env
#
# The secret goes in .env ONLY. Do not paste it into chat, source files,
# or anything that can be committed.

# Keycloak token endpoint (realm: prd-sehhati)
OPTIMA_TOKEN_URL=https://api.sgh.iohealth.com/auth/realms/prd-sehhati/protocol/openid-connect/token

# GraphQL gateway
OPTIMA_GRAPHQL_URL=https://api.sgh.iohealth.com/gateway/graphql

# client_credentials grant
OPTIMA_CLIENT_ID=integration_client
OPTIMA_CLIENT_SECRET=
OPTIMA_SCOPE=profile

# Tenant scoping for the Teams query (from the RCM user's token claims)
OPTIMA_VENDOR_ID=3
OPTIMA_BRANCH_IDS=14,13,12,11,10,9,8,7,6,5,4,3
